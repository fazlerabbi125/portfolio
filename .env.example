# PostgreSQL 15+ connection string. Add sslmode=require for hosted databases.
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?sslmode=require"

# Credentials used only by the administrator seed script.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Administrator"

# A secure random value of at least 32 characters for iron-session.
SESSION_SECRET="replace-with-a-minimum-32-character-session-secret"

# Resend configuration for contact form delivery.
RESEND_API_KEY="re_123456789"

# Canonical portfolio URL shared by the social buttons.
NEXT_PUBLIC_APP_URL="https://your-domain.example"
